#!/bin/false

# ONT (PON module) management subnet on the WAN side, and the router's address in it.
# Sourced by ONT_Route.sh (route, secondary address, firewall rules, SNAT).
ONT_NET=192.168.255.0
ONT_IP=192.168.255.1
ROUTER_ONT_IP=192.168.255.2
ONT_NET_SUFFIX=30

ONT_NET_CIDR="$ONT_NET"/"$ONT_NET_SUFFIX"
ROUTER_ONT_IP_CIDR="$ROUTER_ONT_IP"/"$ONT_NET_SUFFIX"
